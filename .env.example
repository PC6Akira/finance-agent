# ===== 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 排除，绝不提交）=====

# LLM 主模型
DEEPSEEK_API_KEY=

# Embedding（千问 DashScope）
QWEN_API_KEY=

# 通用搜索（基金经理访谈等开放式检索，国内免代理，备选）
BOCHA_API_KEY=

# （弃用）Tavily 需代理，国内环境默认不用
# TAVIL_API_KEY=

# 数据源（如需付费数据源再补充）
# TUSHARE_TOKEN=

# ===== 服务启动（Gradio，部署时按需覆盖）=====
# 监听地址：本机开发 / Nginx 反代场景都保持 127.0.0.1（由 Nginx 对外）
# GRADIO_SERVER_NAME=127.0.0.1
# 监听端口
# GRADIO_SERVER_PORT=7860
# 可选：应用层访问控制（HTTP Basic Auth，与站内账号登录是两层；两者都填才启用）
# GRADIO_AUTH_USERNAME=
# GRADIO_AUTH_PASSWORD=

# ===== Redis（数据缓存 + 限流；挂掉自动降级，不影响业务）=====
# REDIS_URL=redis://localhost:6379/0
